{
  "name": "loth",
  "version": "0.1.0",
  "description": "Liturgy of the Hours assembler",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "pretest": "npm run validate:data",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures:update": "cross-env UPDATE_FIXTURES=1 vitest run tests/integration",
    "generate:data": "npm run build && node scripts/generate-data.mjs",
    "validate:data": "npm run build && node scripts/validate-data.mjs",
    "fetch:kln-melodies": "node scripts/fetch-kln-melodies.mjs",
    "split:kln-melodies": "python scripts/split-kln-pdfs.py",
    "split:kln-melodies:force": "python scripts/split-kln-pdfs.py --force",
    "parse:kln-gabc": "python scripts/parse-kln-pdfs.py",
    "parse:kln-gabc:force": "python scripts/parse-kln-pdfs.py --force",
    "parse:kln-gabc:dry-run": "python scripts/parse-kln-pdfs.py --dry-run",
    "transcribe:kln-vector": "python scripts/transcribe-kln-vector.py",
    "transcribe:kln-vector:force": "python scripts/transcribe-kln-vector.py --force",
    "apply:kln-word-grouping": "python scripts/apply-kln-word-grouping.py",
    "apply:kln-word-grouping:force": "python scripts/apply-kln-word-grouping.py --force",
    "render:kln-gabc": "python scripts/render-kln-gabc.py",
    "render:kln-gabc:force": "python scripts/render-kln-gabc.py --force"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.0",
    "vitest": "^3.1.0"
  }
}
