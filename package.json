{
  "name": "@vagdur/loth",
  "version": "0.3.0",
  "description": "Liturgy of the Hours assembler",
  "license": "MIT",
  "author": "Vilhelm Agdur",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vagdur/LoTH.git"
  },
  "keywords": [
    "liturgy-of-the-hours",
    "divine-office",
    "breviary",
    "gregorian-chant",
    "gabc"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/browser/lothChant.js",
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./browser": {
      "types": "./dist/browser/lothChant.d.ts",
      "default": "./dist/browser/lothChant.js"
    },
    "./loth.css": "./html/loth.css",
    "./package.json": "./package.json",
    "./kln": {
      "types": "./dist/kln/index.d.ts",
      "default": "./dist/kln/index.js"
    }
  },
  "files": [
    "dist/",
    "html/loth.css",
    "html/ExsurgeChar.otf",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm run build && npm run check:worker-safe && node scripts/stage-package-assets.mjs",
    "prepublishOnly": "node scripts/assert-no-data-in-tarball.mjs",
    "build": "tsc && tsc -p tsconfig.browser.json",
    "dev": "tsc --watch",
    "serve:hours": "npm run build && node scripts/serve-hours.mjs",
    "check:worker-safe": "esbuild dist/index.js --bundle --platform=browser --format=esm --external:@vagdur/exsurge --outfile=node_modules/.cache/loth/worker-safe-check.js",
    "pretest": "npm run validate:data && npm run check:worker-safe",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fixtures:update": "cross-env UPDATE_FIXTURES=1 vitest run tests/integration",
    "test:fixtures:compile-pdf": "cross-env COMPILE_FIXTURE_PDF=1 vitest run --config vitest.fixtures-pdf.config.ts",
    "generate:data": "npm run build && node scripts/generate-data.mjs",
    "generate:ordo": "npm run build && node scripts/generate-ordo.mjs",
    "validate:data": "npm run build && node scripts/validate-data.mjs",
    "extract:ordo-calendar": "python scripts/extract-ordo-calendar.py",
    "build:calendars": "python scripts/build-sanctoral-calendars.py",
    "check:ordo-calendar": "npm run build && node scripts/check-ordo-calendar.mjs",
    "compile:melodies": "npm run build && node scripts/compile-melody-store.mjs",
    "map:melodies": "node scripts/map-melodies.mjs",
    "map:melodies:apply": "node scripts/map-melodies.mjs --apply",
    "map:melodies:agent-tasks": "node scripts/map-melodies.mjs --apply --emit-agent-tasks",
    "import:melodies": "npm run build && node scripts/import-melody-texts.mjs",
    "report:melody-coverage": "node scripts/report-melody-coverage.mjs",
    "schedule:melodies": "npm run build && node scripts/compute-melody-schedule.mjs",
    "fetch:kln-melodies": "node scripts/fetch-kln-melodies.mjs",
    "split:kln-melodies": "python scripts/split-kln-pdfs.py",
    "split:kln-melodies:force": "python scripts/split-kln-pdfs.py --force",
    "transcribe:kln-vector": "python scripts/transcribe-kln-vector.py",
    "transcribe:kln-vector:force": "python scripts/transcribe-kln-vector.py --force",
    "apply:kln-word-grouping": "python scripts/apply-kln-word-grouping.py",
    "apply:kln-word-grouping:force": "python scripts/apply-kln-word-grouping.py --force",
    "mark:kln-duplicates": "python scripts/mark-kln-duplicates.py",
    "mark:kln-duplicates:dry-run": "python scripts/mark-kln-duplicates.py --dry-run",
    "mark:kln-split-failures": "python scripts/mark-kln-split-failures.py",
    "mark:kln-split-failures:dry-run": "python scripts/mark-kln-split-failures.py --dry-run",
    "check:kln-parity": "npm run build && node scripts/check-kln-parity.mjs"
  },
  "dependencies": {
    "@vagdur/exsurge": "^1.28.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0",
    "vitest": "^3.1.0"
  }
}
