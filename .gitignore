node_modules
dist

# Environment variables - contains API keys
.env

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# Split melody PDFs — large binary output, reproducible by running split-kln-pdfs.py
# The index.json files in these directories are NOT ignored: they contain GABC
# transcriptions and validation state accumulated by the pipeline.
raw_data/kln/split/**/*.pdf

# Gregorio compile output from validate-kln-gabc.py (preview PDFs), reproducible.
raw_data/kln/split/**/_render/

# Per-PDF agent task files for the melody-mapping pass — regenerated by
# `npm run map:melodies:agent-tasks`. proposals.yaml / calendar_proposals.yaml
# (the review ledgers) ARE tracked.
data/sv/melody_mapping/agent_tasks/
